# Admin API base URL for Vite build.
# Contabo (same host as admin SPA): leave empty — app uses window.location.origin + /api.
# Local dev: http://localhost:4000
# Render static admin (osmani-admin-mpya): leave empty — runtime forces https://api.osmanitv.com/api
# so channel/banner uploads land on Contabo disk. NEVER set osmani-admin-api.onrender.com.
VITE_API_BASE_URL=
