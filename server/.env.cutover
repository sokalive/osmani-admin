# Non-secret Contabo production defaults — loaded only when OSMANI_LOAD_CUTOVER_ENV=1 (Contabo PM2).
# Never auto-loaded on Render (would point legacy APK stream URLs at the VPS).
# Secrets (DATABASE_URL, payment keys) stay in server/.env only.

NODE_ENV=production
PORT=10001

BASE_URL=https://api.osmanitv.com
STREAM_API_BASE_URL=https://api.osmanitv.com
ADMIN_PUBLIC_URL=https://admin.osmanitv.com
BUNNY_CDN_BASE_URL=https://osmanitv.b-cdn.net
ASSET_LEGACY_ORIGIN_HOSTS=144.91.117.90,api.osmanitv.com,admin.osmanitv.com,osmani-admin-api.onrender.com

ADMIN_API_TOKEN=3030
APP_UPDATE_ADMIN_TOKEN=3030

UPLOAD_DIR=/var/www/osmani-admin-api/server/uploads
NOTIFICATION_IMAGE_PUBLIC_ORIGIN=https://api.osmanitv.com
